# ================================================================
# ORBIT OS — Environment Variables
# ================================================================
# Copy this file to .env.local for local development.
# .env.local is gitignored by Next.js — NEVER commit it.
# This file (.env.example) is safe to commit — no real secrets here.
# ================================================================

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Orbit OS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Gemini AI (Google DeepMind) ──────────────────────────────────
# SERVER-SIDE ONLY — used only in /api/ai/* route handlers
# Get your key: https://ai.google.dev/gemini-api/docs/api-key
# Choose model: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Google Calendar API ───────────────────────────────────────────
# SERVER-SIDE ONLY — OAuth 2.0 credentials
# Create project & credentials: https://console.cloud.google.com/
# Enable "Google Calendar API" in API Library
# Create OAuth 2.0 Client ID (Web application type)
# Add authorized redirect URI below to Google Console
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Spotify Web API ───────────────────────────────────────────────
# Create app: https://developer.spotify.com/dashboard
# CLIENT_ID may be used client-side in PKCE flows
# CLIENT_SECRET is SERVER-SIDE ONLY — token exchange only
# Add redirect URI in Spotify Dashboard settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# ── OpenWeather API ───────────────────────────────────────────────
# SERVER-SIDE ONLY (preferred — avoids key exposure in browser)
# Sign up & get key: https://openweathermap.org/api
# Free tier includes current weather & 5-day forecast
OPENWEATHER_API_KEY=
OPENWEATHER_DEFAULT_CITY=Ankara
OPENWEATHER_DEFAULT_COUNTRY=TR

# ── Firebase (Phase 5) ────────────────────────────────────────────
# Public config — safe for NEXT_PUBLIC_ prefix
# Get config: Firebase Console → Project Settings → Your apps
# IMPORTANT: Configure Firestore Security Rules before production!
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Supabase (Phase 5 alternative) ───────────────────────────────
# Anon key is public — safe for NEXT_PUBLIC_ prefix
# IMPORTANT: Configure Row-Level Security (RLS) before production!
# Get URL + keys: https://app.supabase.com/ → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER-SIDE ONLY (bypasses all RLS — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
